# EmailJS credentials — get these from https://www.emailjs.com/
# Copy this file to .env.local and fill in your real values.
# DO NOT commit .env.local to version control.

# Service ID: Dashboard → Email Services → your service → Service ID
NEXT_PUBLIC_EMAILJS_SERVICE_ID=your_service_id

# Template ID: Dashboard → Email Templates → your template → Template ID
NEXT_PUBLIC_EMAILJS_TEMPLATE_ID=your_template_id

# Public Key: Dashboard → Account → General → Public Key
NEXT_PUBLIC_EMAILJS_PUBLIC_KEY=your_public_key

# ─── Firebase (free-training registration + /admin dashboard) ───────────────
# Firebase Console → Project settings → General → Your apps → Web app → SDK config.
# These are public client identifiers, not secrets; access is enforced by firestore.rules.
NEXT_PUBLIC_FIREBASE_API_KEY=AIzaSyBgvsFS5aWQlyLTrAmcN4DlL3kw2AVuJkw
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=freshkitewebsite.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=freshkitewebsite
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=freshkitewebsite.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=329263551610
NEXT_PUBLIC_FIREBASE_APP_ID=1:329263551610:web:c0be6e4fedc87d1c8a17c3

# Optional but recommended: App Check with reCAPTCHA v3 to block scripted spam.
# Firebase Console → App Check → register the web app → reCAPTCHA v3 site key.
NEXT_PUBLIC_FIREBASE_APPCHECK_SITE_KEY=
# Set to "true" in .env.local only, to print an App Check debug token for localhost.
NEXT_PUBLIC_FIREBASE_APPCHECK_DEBUG=false
